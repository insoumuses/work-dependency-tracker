/**
 * GGET依頼管理表専用：
 * 展開menuで生成されたparametersの中からSNS依頼だけmessageを差し替える
 */
function ggetSnsOverrideForIraiKanri20260703_(parameters, botKun) {
  console.log('★★★★★ ggetSnsOverrideForIraiKanri20260703_ CALLED ★★★★★');

  const config = botKun.pj.config.data;
  let appliedCount = 0;

  walkGgetParams_(parameters, function(obj) {
    if (!obj || typeof obj !== 'object') {
      return;
    }

    if (typeof obj.message !== 'string') {
      return;
    }

    const rawText = obj.rawArray ? obj.rawArray.join(' ') : '';
    const messageText = obj.message || '';

    // rawArrayまたは既存message内にSNS / ＳＮＳが含まれる場合のみ対象
    const isSns = /SNS|ＳＮＳ/i.test(rawText) || /SNS|ＳＮＳ/i.test(messageText);

    if (!isSns) {
      return;
    }

    obj.message = makeGgetSnsMessage20260703_(obj, config);
    appliedCount++;
  });

  console.log('GGET SNS override applied count: ' + appliedCount);

  return parameters;
}


/**
 * parametersの中を再帰的に探す
 * messageを持つオブジェクトがどこにあっても処理できるようにする
 */
function walkGgetParams_(value, callback) {
  if (Array.isArray(value)) {
    value.forEach(function(item) {
      walkGgetParams_(item, callback);
    });
    return;
  }

  if (value && typeof value === 'object') {
    callback(value);

    Object.keys(value).forEach(function(key) {
      walkGgetParams_(value[key], callback);
    });
  }
}


/**
 * SNS依頼用の展開メッセージを作成
 */
function makeGgetSnsMessage20260703_(task, config) {
  const oldMessage = task.message || '';

  // 既存messageの先頭にあるTo指定を残す
  const toPrefix = extractGgetToPrefix20260703_(oldMessage);

  const template = `お疲れ様です(coffee)
SNS関連の依頼が届きました。下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}

{投稿日時}
{社外シート}
{備考}
[/info]
[code]BNE【GGET_SNS補助】【海外】SNS運用[/code]

よろしくお願いいたします。`;

  let message = template;

  const variablesToSearch = template.match(/(?<={)(.*?)(?=})/g) || [];

  variablesToSearch.forEach(function(headerName) {
    let value = getGgetValueByHeader20260703_(task, config, headerName);

    if (value === null || value === undefined) {
      value = '';
    }

    if (value instanceof Date) {
      value = formatGgetDate20260703_(value);
    }

    message = message.replaceAll('{' + headerName + '}', value);
  });

  return toPrefix + message;
}


/**
 * 既存message先頭の [To:xxxx] 群を保持する
 */
function extractGgetToPrefix20260703_(message) {
  const greeting = 'お疲れ様です(coffee)';
  const index = message.indexOf(greeting);

  if (index === -1) {
    return '';
  }

  return message.substring(0, index);
}


/**
 * header名からrawArray内の値を取得
 */
function getGgetValueByHeader20260703_(task, config, headerName) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) {
    return '';
  }

  const colIndex = config.currentHeaders.indexOf(headerName);

  if (colIndex === -1) {
    return '';
  }

  const value = task.rawArray[colIndex];

  if (value === null || value === undefined) {
    return '';
  }

  return value;
}


/**
 * 日付を m/d(曜) HH:mm 形式にする
 */
function formatGgetDate20260703_(date) {
  let dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
  dateStr += `(${['日','月','火','水','木','金','土'][date.getDay()]}) `;

  let hours = date.getHours().toString();
  let minutes = date.getMinutes().toString();

  dateStr += hours.length === 1 ? '0' + hours : hours;
  dateStr += ':';
  dateStr += minutes.length === 1 ? '0' + minutes : minutes;

  return dateStr;
}
