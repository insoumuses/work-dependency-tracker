/**
 * GGET依頼管理表専用：
 * 展開menuで生成されたparametersの中からSNS依頼だけmessageを差し替える
 */
function ggetSnsOverrideForIraiKanri20260703_(parameters, botKun) {
  console.log('★★★★★ ggetSnsOverrideForIraiKanri20260703_ CALLED ★★★★★');

  const config = botKun.pj.config.data;
  let appliedCount = 0;

  walkGgetParams_(parameters, function(obj) {
    if (!obj || typeof obj !== 'object') {
      return;
    }

    if (typeof obj.message !== 'string') {
      return;
    }

    if (!obj.rawArray) {
      return;
    }

    // カテゴリー列だけを見る
    const category = getGgetValueByHeader20260703_(obj, config, 'カテゴリー');

    console.log('category check: ' + category);

    // カテゴリーに SNS / ＳＮＳ が含まれる場合のみ対象
    const isSns = /SNS|ＳＮＳ/i.test(category || '');

    if (!isSns) {
      return;
    }

    obj.message = makeGgetSnsMessage20260703_(obj, config);
    appliedCount++;
  });

  console.log('GGET SNS override applied count: ' + appliedCount);

  return parameters;
}
