/**
 * GGET依頼管理表専用：
 * 設定!A2 の内容で通常モード / SNSモードを切り替える
 *
 * 通常モード：
 *   SNS以外の案件だけ残す
 *   設定!A2 の通常テンプレートで message を作り直す
 *
 * SNSモード：
 *   SNS案件だけ残す
 *   設定!A2 のSNSテンプレートで message を作り直す
 */
function ggetModeRewriteV2_20260703_(parameters, botKun) {
  const config = botKun.pj.config.data;
  const activeTemplate = ggetReadSettingA2TemplateV2_20260703_();

  const isSnsMode = /SNS関連の依頼が届きました/.test(activeTemplate || '');

  const mode = isSnsMode ? 'SNS_ONLY' : 'NON_SNS_ONLY';

  console.log('GGET mode = ' + mode);
  console.log('template preview = ' + String(activeTemplate).slice(0, 200));

  return ggetRewriteParamsV2_20260703_(parameters, config, activeTemplate, mode);
}


/**
 * parameters 全体を再帰的に見て、依頼データ配列を処理する
 *
 * mode = SNS_ONLY     ：SNS案件だけ残す
 * mode = NON_SNS_ONLY ：SNS以外の案件だけ残す
 */
function ggetRewriteParamsV2_20260703_(value, config, template, mode) {
  if (Array.isArray(value)) {
    const hasTaskObjects = value.some(function(item) {
      return ggetIsTaskObjectV2_20260703_(item);
    });

    if (hasTaskObjects) {
      console.log('Task array found. before count = ' + value.length);
      console.log('filter mode = ' + mode);

      const result = value
        .filter(function(item) {
          if (!ggetIsTaskObjectV2_20260703_(item)) {
            return true;
          }

          const requestNo = ggetGetValueByHeaderV2_20260703_(item, config, '依頼番号');
          const category = ggetGetValueByHeaderV2_20260703_(item, config, 'カテゴリー');
          const isSns = ggetIsSnsTaskV2_20260703_(item, config);

          console.log('task check: ' + requestNo + ' / ' + category + ' / isSns=' + isSns);

          if (mode === 'SNS_ONLY') {
            return isSns;
          }

          if (mode === 'NON_SNS_ONLY') {
            return !isSns;
          }

          return true;
        })
        .map(function(item) {
          if (!ggetIsTaskObjectV2_20260703_(item)) {
            return item;
          }

          item.message = ggetMakeMessageFromTemplateV2_20260703_(item, config, template);
          return item;
        });

      console.log('Task array after count = ' + result.length);
      return result;
    }

    return value.map(function(item) {
      return ggetRewriteParamsV2_20260703_(item, config, template, mode);
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteParamsV2_20260703_(value[key], config, template, mode);
    });
  }

  return value;
}
