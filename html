<script>

      // OVERALL VUE:
        // An Async process is necessary to get all the tenkai data needed from the server (GAS, sheet side)
        // the passDataToCallBackFunc will call the getTenkaiParams from the server,
        // and then pass the resolved data to all callback functions

      
      // SERVER-SIDE CALL FUNCTION
      
      // gets data using a server-side function
      // passes it as parameters to all client call back functions
      function ServerClientHandler () {

        const getServerPromise = function (serverFuncName) {
          return new Promise((resolve, reject) => {
            google.script.run.withSuccessHandler((data) => {
                resolve(data)
              }).withFailureHandler((err) => {
                reject(err)
              })[serverFuncName]()
          });
        }

        this.passDataToCallBackFunc = async function (serverGetFunctionName, ...clientCallBackFunctions) {
          try {
            let data = await getServerPromise(serverGetFunctionName);
            data = JSON.parse(data)
            clientCallBackFunctions.forEach(func => {
              func(data);
            })
          } catch (error) {
            alert(error);
          }
        }

      }

      // JQUERIES TO CONTROL THE HTML ELEMENTS

      // define all html elements to be impacted by the change of data from server
      let currentTask
      let params
      const updateParams = function (paramsFromServer) {
        params = paramsFromServer
        currentTask = params.tasks[2]
      }

      // textArea for the tenkai message
      const textArea = $("#text-edit");
      const changeTextAreaVal = function (paramsFromServer) {
        textArea.val(params.tasks[params.tasks.length-1].message);
        textArea.css("visibility","visible");
        textArea.css("opacity","1");
      }
      const logValInTextArea = function (paramsFromServer) {
        // alert(paramsFromServer)
        textArea.val(paramsFromServer);
        textArea.css("visibility","visible");
        textArea.css("opacity","1");
      }

      // dislays explanations at the top for users
      const explanationTxt = $("#explanations");
      const actualiseExplanations = function (paramsFromServer) {
        explanationTxt.css("visibility","hidden");
        explanationTxt.css("opacity","0");
        let newHtmlTxt = `下記の展開文をご確認・ご編集の上、<br>「送信」ボタンを押してください。`;
        explanationTxt.html(newHtmlTxt);
        explanationTxt.css("visibility","visible");
        explanationTxt.css("opacity","1");
      }

      // public send button
      const sendBtn = $("#send-button");
      const activateButton = function (paramsFromServer) {
        let newHtmlTxt = "「" + paramsFromServer.room.name + "」へ<br>送信！";
        sendBtn.html(newHtmlTxt);
        sendBtn.click(function() {
          let body = textArea.val();
          let room = params.room.id;
          try {
            google.script.run.sendMessageAndToastUser(room, body);
            google.script.host.close();
          } catch (err){
            alert(err);
          }
        })
        sendBtn.css("visibility","visible");
        sendBtn.css("opacity","1");
      }

      // private send button
      const privateSendBtn = $("#private-send-button");
      const activatePrivateButton = function (paramsFromServer) {

        let newHtmlTxt = params.tasks[params.tasks.length-1].tanto ?
          "「" + params.tasks[params.tasks.length-1].tanto["呼び方"] + "さん」だけに<br>🤫プライベート送信！🤫"
          : "登録されていないユーザー名が「担当」になっていますので、<br>🙊プライベート送信が不可能🙊"
        privateSendBtn.html(newHtmlTxt);

        privateSendBtn.click(function() {
          let body = textArea.val()
          try {
            if(currentTask.tanto) {
              google.script.run.sendPrivateMessageAndToastUser(currentTask.tanto['呼び方'], body);
            }
            else {
              alert('この依頼の「担当」が登録されていないので、\nプライベート送信が不可能になっています。\n「設定」シートで「担当」のリストを更新してください。')
            }
            
          } catch (err){
            alert(err);
          }
        })
        privateSendBtn.css("visibility","visible");
        privateSendBtn.css("opacity","1");
      }

      // called by the radio buttons below
      const updateCurrentTask = function (taskIndex) {
        currentTask = params.tasks[taskIndex]
        textArea.val(currentTask["message"])

        let newHtmlTxt = currentTask.tanto ?
          "「" + currentTask.tanto["呼び方"] + "さん」だけに<br>🤫プライベート送信！🤫"
          : "登録されていないユーザー名が「担当」になっていますので、<br>🙊プライベート送信が不可能🙊"
        
        privateSendBtn.html(newHtmlTxt)
      }

      // init the radio buttons
      const taskSelectRadios = $('input[name="task_select"]');
      const initTaskSelector = function (paramsFromServer) {

        let paragraph = $("#taskSelectPar")
        paragraph.css("visibility","visible");
        paragraph.css("opacity","1")

        let currentLabel

        // init the changes of message AND PRIVATE SEND based on button selection
        for (let i= 0; i < paramsFromServer.tasks.length; i++) {
          currentLabel = $('#label_'+(i+1))

          currentLabel
            .text(`【${paramsFromServer.tasks[i].taskNum}】：${paramsFromServer.tasks[i].taskType}（${Object.entries(paramsFromServer.tasks[i].teams)
              .filter(([team, status]) => status === '')
              .map (([team, status]) => team)
              .join('・')}）`)

          currentLabel.css("visibility","visible");
          currentLabel.css("opacity","1");

          taskSelectRadios[i].style.visibility = "visible"
          taskSelectRadios[i].style.opacity = "1"

          taskSelectRadios[i].addEventListener('change', function() {
            updateCurrentTask(taskSelectRadios[i].value)
          });
        }

        textArea.css("visibility","visible");
        textArea.css("opacity","1");

      }

      // MAIN PROCESS

      const serverToClient = new ServerClientHandler();

      serverToClient.passDataToCallBackFunc(
        "getTenkaiParams", 
        updateParams,
        initTaskSelector,
        actualiseExplanations, 
        /**actualiseErrorDiv,*/ 
        changeTextAreaVal, 
        activateButton,
        activatePrivateButton
      );

      

    </script>
