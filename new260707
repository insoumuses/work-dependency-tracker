// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  let botKun = BotKun.summon(magicIncantation);
  botKun.loadProject();

  // 通常通り3件取得
  let parameters = botKun.pj.tenkai.makeTenkaiParams(3);

  // GGET用：投稿日時の有無で通常 / SNS テンプレートを自動切替
  parameters = ggetModeRewriteV8_20260707_(parameters, botKun);

  console.log(JSON.stringify(parameters, null, 2));

  console.timeEnd('Loading message');
  return JSON.stringify(parameters);
}


/**
 * GGET依頼管理表専用：
 *
 * 判断基準：
 *   投稿日時あり → SNS関連依頼
 *   投稿日時なし → SNS以外の依頼
 *
 * ※ カテゴリー名では判断しない。
 * ※ 202607などの月別シート名は書き死にしない。
 * ※ 【ver.1】/【ver.2】は本文に入れない。
 */
function ggetModeRewriteV8_20260707_(parameters, botKun) {
  const config = botKun.pj.config.data;

  const templates = {
    normal:
`お疲れ様です(coffee)
下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}
{社内シート}
{備考}[/info]
[code]{PJコード}[/code]
よろしくお願いいたします。`,

    sns:
`お疲れ様です(coffee)
SNS関連の依頼が届きました。下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}
{投稿日時}
{社外シート}
{備考}
[/info]
[code]{PJコード}[/code]
よろしくお願いいたします。`
  };

  console.log('========== GGET TEMPLATE AUTO MODE V8 ==========');
  console.log('normal template preview:\n' + templates.normal);
  console.log('sns template preview:\n' + templates.sns);
  console.log('================================================');

  return ggetRewriteParamsV8_20260707_(parameters, config, templates);
}


/**
 * parameters を再帰的に処理して message を書き換える。
 */
function ggetRewriteParamsV8_20260707_(value, config, templates) {
  if (Array.isArray(value)) {
    const hasTaskObjects = value.some(function(item) {
      return ggetIsTaskObjectV8_20260707_(item);
    });

    if (hasTaskObjects) {
      console.log('タスク配列を検出: ' + value.length + '件');

      return value.map(function(item) {
        if (!ggetIsTaskObjectV8_20260707_(item)) return item;

        const requestNo = ggetGetValueByHeaderV8_20260707_(item, config, '依頼番号', true);
        const category  = ggetGetValueByHeaderV8_20260707_(item, config, 'カテゴリー', true);
        const isSns     = ggetIsSnsTaskV8_20260707_(item, config);

        console.log('[' + requestNo + '] カテゴリー="' + category + '" / isSns=' + isSns);

        const template = isSns ? templates.sns : templates.normal;

        item.message = ggetMakeMessageFromTemplateV8_20260707_(item, config, template);

        if (item.message === null || item.message === undefined) {
          item.message = '';
        }

        return item;
      });
    }

    return value.map(function(item) {
      return ggetRewriteParamsV8_20260707_(item, config, templates);
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteParamsV8_20260707_(value[key], config, templates);
    });
  }

  return value;
}


/**
 * BotKun の依頼データオブジェクト判定。
 */
function ggetIsTaskObjectV8_20260707_(obj) {
  return obj && typeof obj === 'object' && Array.isArray(obj.rawArray);
}


/**
 * SNS関連依頼の判定。
 *
 * 判断基準：
 *   投稿日時に実質的な内容がある → SNS関連
 *   投稿日時が空                 → SNS以外
 *
 * ※ カテゴリーでは判断しない。
 * ※ BotKunのheadersに投稿日時がない場合は、Spreadsheet本体から依頼番号で探す。
 */
function ggetIsSnsTaskV8_20260707_(task, config) {
  const requestNo = ggetGetValueByHeaderV8_20260707_(task, config, '依頼番号', true);
  const category  = ggetGetValueByHeaderV8_20260707_(task, config, 'カテゴリー', true);

  let postDateValue = ggetGetPostDateValueV8_20260707_(task, config);

  const isSns = ggetHasMeaningfulValueV8_20260707_(postDateValue);

  console.log(
    '[' + requestNo + '] SNS判定: ' +
    'category="' + category + '", ' +
    '投稿日時="' + postDateValue + '", ' +
    'isSns=' + isSns
  );

  return isSns;
}


/**
 * 投稿日時を取得する。
 *
 * 1. BotKunのrawArrayから取得
 * 2. 取れない場合、Spreadsheet本体から依頼番号で取得
 */
function ggetGetPostDateValueV8_20260707_(task, config) {
  const requestNo = ggetGetValueByHeaderV8_20260707_(task, config, '依頼番号', true);

  let value = ggetGetValueByHeaderLooseV8_20260707_(task, config, [
    '投稿日時',
    '投稿時間',
    '投稿日',
    '投稿日・時間'
  ]);

  if (ggetHasMeaningfulValueV8_20260707_(value)) {
    return value;
  }

  value = ggetFindValueFromSheetByRequestNoV8_20260707_(
    requestNo,
    [
      '投稿日時',
      '投稿時間',
      '投稿日',
      '投稿日・時間'
    ]
  );

  return value;
}


/**
 * テンプレートから message を生成。
 */
function ggetMakeMessageFromTemplateV8_20260707_(task, config, template) {
  const oldMessage = task.message || '';
  const toPrefix   = ggetExtractToPrefixV8_20260707_(oldMessage);

  let message = String(template || '');

  if (!message.trim()) {
    console.warn('テンプレートが空 → 旧messageを保持');
    return oldMessage;
  }

  const variablesToSearch = message.match(/(?<={)([^{}]+)(?=})/g) || [];

  variablesToSearch.forEach(function(headerName) {
    let value = ggetResolveTemplateValueV8_20260707_(task, config, oldMessage, headerName);

    if (value === null || value === undefined) value = '';

    if (value instanceof Date) {
      value = ggetFormatDateV8_20260707_(value);
    } else if (typeof value === 'string' && ggetIsDateStringV8_20260707_(value)) {
      value = ggetFormatDateV8_20260707_(new Date(value));
    }

    message = ggetReplaceAllV8_20260707_(message, '{' + headerName + '}', String(value));
  });

  // 念のため、ver見出しが混入した場合は削除
  message = message
    .replace(/^[\s　]*[【\[]ver\.\d+[】\]][\s　]*\n?/gmi, '')
    .replace(/\[code\]\s*\[\/code\]/g, '[code][/code]');

  return toPrefix + message;
}


/**
 * テンプレート変数ごとの値を取得。
 */
function ggetResolveTemplateValueV8_20260707_(task, config, oldMessage, headerName) {
  const requestNo = ggetGetValueByHeaderV8_20260707_(task, config, '依頼番号', true);

  if (headerName === 'PJコード') {
    return ggetCleanCodeValueV8_20260707_(
      ggetExtractCodeBlockV8_20260707_(oldMessage)
      || ggetGetValueByHeaderV8_20260707_(task, config, 'PJコード', true)
    );
  }

  if (headerName === '社内締切') {
    return ggetExtractDeadlineFromOldMessageV8_20260707_(oldMessage)
      || ggetGetValueByHeaderV8_20260707_(task, config, '社内締切', true);
  }

  if (headerName === '社内シート') {
    return ggetGetValueByHeaderLooseV8_20260707_(task, config, [
      '社内シート',
      '社内sheet',
      '社内Sheet',
      '社内SHEET'
    ]);
  }

  if (headerName === '社外シート') {
    return ggetGetValueByHeaderLooseV8_20260707_(task, config, [
      '社外シート',
      '社外sheet',
      '社外Sheet',
      '社外SHEET'
    ]);
  }

  if (headerName === '投稿日時') {
    return ggetGetPostDateValueV8_20260707_(task, config);
  }

  if (headerName === '備考') {
    return ggetGetValueByHeaderLooseV8_20260707_(task, config, [
      '備考',
      'メモ',
      'コメント'
    ]);
  }

  if (headerName === '展開メッセージ') {
    return '';
  }

  return ggetGetValueByHeaderV8_20260707_(task, config, headerName, true);
}


/**
 * ヘッダー名の揺れに対応して値を取得。
 */
function ggetGetValueByHeaderLooseV8_20260707_(task, config, headerNames) {
  for (const name of headerNames) {
    const value = ggetGetValueByHeaderV8_20260707_(task, config, name, true);
    if (ggetHasMeaningfulValueV8_20260707_(value)) {
      return value;
    }
  }

  return '';
}


/**
 * headerName から rawArray の値を取得。
 */
function ggetGetValueByHeaderV8_20260707_(task, config, headerName, silent) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) return '';

  const colIndex = config.currentHeaders.indexOf(headerName);

  if (colIndex === -1) {
    if (!silent) {
      console.warn('ヘッダーが見つかりません: "' + headerName + '"');
      console.log('currentHeaders = ' + JSON.stringify(config.currentHeaders));
    }
    return '';
  }

  const value = task.rawArray[colIndex];
  return (value === null || value === undefined) ? '' : value;
}


/**
 * Spreadsheet本体から、依頼番号をキーにして指定ヘッダーの値を取得する。
 *
 * 202607などのシート名は固定しない。
 * 「依頼番号」と「投稿日時」を持つシートを自動で探す。
 */
function ggetFindValueFromSheetByRequestNoV8_20260707_(requestNo, targetHeaderNames) {
  if (!requestNo) return '';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();

  const normalizedRequestNo = String(requestNo).trim();

  for (const sheet of sheets) {
    const sheetName = sheet.getName();

    // 設定系・テンプレ系のシートは除外
    if (
      /設定|テンプレート|定型文|リマインダー|休日|シフト|対応/.test(sheetName)
    ) {
      continue;
    }

    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();

    if (lastRow < 2 || lastCol < 1) continue;

    const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];

    const requestNoCol = ggetFindHeaderIndexV8_20260707_(headers, ['依頼番号']);
    const targetCol = ggetFindHeaderIndexV8_20260707_(headers, targetHeaderNames);

    if (requestNoCol === -1 || targetCol === -1) {
      continue;
    }

    const values = sheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

    for (let r = 0; r < values.length; r++) {
      const rowRequestNo = String(values[r][requestNoCol] || '').trim();

      if (rowRequestNo === normalizedRequestNo) {
        const foundValue = values[r][targetCol];

        console.log(
          '[fallback] sheet="' + sheetName + '" ' +
          '依頼番号="' + normalizedRequestNo + '" ' +
          'target="' + headers[targetCol] + '" ' +
          'value="' + foundValue + '"'
        );

        return foundValue || '';
      }
    }
  }

  console.warn('[fallback] 指定ヘッダーの値を取得できませんでした。依頼番号=' + requestNo);
  return '';
}


/**
 * ヘッダー名の表記揺れを吸収して列番号を探す。
 */
function ggetFindHeaderIndexV8_20260707_(headers, targetHeaderNames) {
  const normalizedHeaders = headers.map(function(h) {
    return ggetNormalizeHeaderNameV8_20260707_(h);
  });

  for (const target of targetHeaderNames) {
    const normalizedTarget = ggetNormalizeHeaderNameV8_20260707_(target);
    const index = normalizedHeaders.indexOf(normalizedTarget);

    if (index !== -1) {
      return index;
    }
  }

  return -1;
}


/**
 * ヘッダー名比較用の正規化。
 */
function ggetNormalizeHeaderNameV8_20260707_(value) {
  return String(value || '')
    .replace(/\r/g, '')
    .replace(/\n/g, '')
    .replace(/\t/g, '')
    .replace(/\s/g, '')
    .replace(/　/g, '')
    .trim();
}


/**
 * 空欄・未記入系を除外して、実質的な値があるか判定する。
 */
function ggetHasMeaningfulValueV8_20260707_(value) {
  if (value === null || value === undefined) return false;

  const text = String(value)
    .replace(/\r/g, '')
    .replace(/\n/g, '')
    .replace(/\t/g, '')
    .replace(/\s/g, '')
    .replace(/　/g, '')
    .trim();

  if (!text) return false;

  if (
    text === '⚠️未記入⚠️' ||
    text === '未記入' ||
    text === '-' ||
    text === 'ー'
  ) {
    return false;
  }

  return true;
}


/**
 * 旧messageの先頭 [To:xxxx] 行だけ取り出す。
 */
function ggetExtractToPrefixV8_20260707_(message) {
  if (!message) return '';

  const lines = String(message).split('\n');
  const toLines = [];

  for (const line of lines) {
    if (/^\[To:\d+\]/.test(line)) {
      toLines.push(line);
    } else {
      break;
    }
  }

  return toLines.length > 0 ? toLines.join('\n') + '\n\n' : '';
}


/**
 * 旧messageから [code]...[/code] を取得。
 */
function ggetExtractCodeBlockV8_20260707_(message) {
  if (!message) return '';

  const match = String(message).match(/\[code\]([\s\S]*?)\[\/code\]/);
  return match ? match[1].trim() : '';
}


/**
 * PJコード値に [code] / [/code] が混ざっていた場合に除去。
 */
function ggetCleanCodeValueV8_20260707_(value) {
  return String(value || '')
    .replace(/\[code\]/g, '')
    .replace(/\[\/code\]/g, '')
    .trim();
}


/**
 * 旧messageから title 内の「〆」以降を取得。
 */
function ggetExtractDeadlineFromOldMessageV8_20260707_(message) {
  if (!message) return '';

  const match = String(message).match(/〆([\s\S]*?)\[\/title\]/);
  return match ? match[1].trim() : '';
}


/**
 * Date → m/d(曜) HH:mm
 */
function ggetFormatDateV8_20260707_(date) {
  const days = ['日','月','火','水','木','金','土'];
  const m   = date.getMonth() + 1;
  const d   = date.getDate();
  const w   = days[date.getDay()];
  const h   = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');

  return `${m}/${d}(${w}) ${h}:${min}`;
}


/**
 * Date文字列かどうか判定。
 */
function ggetIsDateStringV8_20260707_(value) {
  if (!value) return false;

  const str = String(value);
  const date = new Date(str);

  return !isNaN(date.getTime())
    && /GMT|標準時|^\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(str);
}


/**
 * Apps Script用 replaceAll 互換。
 */
function ggetReplaceAllV8_20260707_(text, search, replacement) {
  return String(text).split(search).join(replacement);
}
