/**
 * GGET依頼管理表専用・簡易版
 *
 * 判断：
 *   カテゴリーに SNS / ＳＮＳ が含まれる → SNS関連テンプレート
 *   それ以外                         → 通常テンプレート
 *
 * テンプレート：
 *   設定!A2:A10  → 通常テンプレート
 *   設定!A11:A19 → SNSテンプレート
 *   設定!A20:A28 → 予備テンプレート
 *
 * ※ PJコードはBotKun既存の取得関数を優先して使う
 */
function ggetModeRewriteSimple_20260707_(parameters, botKun) {
  var config = botKun.pj.config.data;

  var templates = ggetReadTemplatesFromSettingSimple_20260707_();

  console.log('========== GGET TEMPLATE AUTO MODE ==========');
  console.log('normal template:\n' + templates.normal);
  console.log('sns template:\n' + templates.sns);
  console.log('spare template:\n' + templates.spare);
  console.log('============================================');

  return ggetRewriteSimple_20260707_(parameters, config, templates, botKun);
}

/**
 * 設定シートからテンプレートを取得する。
 *
 * A2:A10  → 通常テンプレート
 * A11:A19 → SNSテンプレート
 * A20:A28 → 予備テンプレート
 */
function ggetReadTemplatesFromSettingSimple_20260707_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('設定');

  if (!sheet) {
    console.warn('設定シートが見つかりません。コード内のデフォルトテンプレートを使用します。');
    return ggetDefaultTemplatesSimple_20260707_();
  }

  var normal = ggetReadTemplateRangeSimple_20260707_(sheet, 'A2:A10');
  var sns    = ggetReadTemplateRangeSimple_20260707_(sheet, 'A11:A19');
  var spare  = ggetReadTemplateRangeSimple_20260707_(sheet, 'A20:A28');

  var defaults = ggetDefaultTemplatesSimple_20260707_();

  return {
    normal: normal || defaults.normal,
    sns:    sns    || defaults.sns,
    spare:  spare  || ''
  };
}


/**
 * 指定範囲の表示値をテンプレート文字列として取得する。
 *
 * 空行もある程度残す。
 * ただし末尾の空行は削除する。
 */
function ggetReadTemplateRangeSimple_20260707_(sheet, rangeA1) {
  var values = sheet.getRange(rangeA1).getDisplayValues();

  var lines = values.map(function(row) {
    return String(row[0] || '');
  });

  // 末尾の空行だけ削除
  while (lines.length > 0 && String(lines[lines.length - 1]).trim() === '') {
    lines.pop();
  }

  return lines.join('\n');
}


/**
 * 設定シートから読めなかった場合のデフォルトテンプレート。
 */
