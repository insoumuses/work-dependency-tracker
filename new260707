// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  var botKun = BotKun.summon(magicIncantation);
  botKun.loadProject();

  var parameters = botKun.pj.tenkai.makeTenkaiParams(3);

  // GGET用：投稿日時の有無で通常 / SNS を自動切替
  parameters = ggetModeRewriteSimple_20260707_(parameters, botKun);

  console.log(JSON.stringify(parameters, null, 2));

  console.timeEnd('Loading message');
  return JSON.stringify(parameters);
}


/**
 * GGET依頼管理表専用・簡易版
 *
 * 判断：
 *   投稿日時あり → SNS関連テンプレート
 *   投稿日時なし → 通常テンプレート
 *
 * ※ テンプレートシートは読まない
 * ※ 月別シート名は見ない
 * ※ 全シート検索しないので軽い
 */
function ggetModeRewriteSimple_20260707_(parameters, botKun) {
  var config = botKun.pj.config.data;

  var templates = {
    normal:
`お疲れ様です(coffee)
下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}
{社内シート}
{備考}[/info]
[code]{PJコード}[/code]
よろしくお願いいたします。`,

    sns:
`お疲れ様です(coffee)
SNS関連の依頼が届きました。下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}

{投稿日時}
{社外シート}
{備考}
[/info]
[code]{PJコード}[/code]

よろしくお願いいたします。`
  };

  return ggetRewriteSimple_20260707_(parameters, config, templates);
}


/**
 * parameters 内の依頼データを探して message を書き換える。
 */
function ggetRewriteSimple_20260707_(value, config, templates) {
  if (Array.isArray(value)) {
    return value.map(function(item) {
      if (ggetIsTaskObjectSimple_20260707_(item)) {
        var isSns = ggetIsSnsSimple_20260707_(item, config);
        var template = isSns ? templates.sns : templates.normal;

        var requestNo = ggetValueSimple_20260707_(item, config, '依頼番号');
        var category  = ggetValueSimple_20260707_(item, config, 'カテゴリー');
        var postDate  = ggetLooseValueSimple_20260707_(item, config, ['投稿日時', '投稿日', '投稿時間']);

        console.log(
          '[' + requestNo + '] category="' + category + '"' +
          ' / 投稿日時="' + postDate + '"' +
          ' / isSns=' + isSns
        );

        item.message = ggetMakeMessageSimple_20260707_(item, config, template);
      } else {
        item = ggetRewriteSimple_20260707_(item, config, templates);
      }

      return item;
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteSimple_20260707_(value[key], config, templates);
    });
  }

  return value;
}


/**
 * BotKunの依頼データ判定。
 */
function ggetIsTaskObjectSimple_20260707_(obj) {
  return obj && typeof obj === 'object' && Array.isArray(obj.rawArray);
}


/**
 * SNS関連判定。
 *
 * 第一判断：
 *   投稿日時が入っているか
 *
 * 兜底：
 *   カテゴリーに 投稿予約 が含まれるか
 */
function ggetIsSnsSimple_20260707_(task, config) {
  var postDate = ggetLooseValueSimple_20260707_(task, config, [
    '投稿日時',
    '投稿日',
    '投稿時間'
  ]);

  if (ggetHasValueSimple_20260707_(postDate)) {
    return true;
  }

  var category = String(ggetValueSimple_20260707_(task, config, 'カテゴリー') || '');

  // 投稿日時が取れない場合の保険
  if (/投稿予約/.test(category)) {
    return true;
  }

  return false;
}


/**
 * テンプレートからmessage生成。
 */
function ggetMakeMessageSimple_20260707_(task, config, template) {
  var oldMessage = String(task.message || '');
  var toPrefix = ggetExtractToPrefixSimple_20260707_(oldMessage);

  var message = String(template || '');
  var variables = message.match(/(?<={)([^{}]+)(?=})/g) || [];

  variables.forEach(function(name) {
    var value = ggetResolveValueSimple_20260707_(task, config, oldMessage, name);

    if (value === null || value === undefined) {
      value = '';
    }

    message = ggetReplaceAllSimple_20260707_(
      message,
      '{' + name + '}',
      String(value)
    );
  });

  return toPrefix + message;
}


/**
 * 変数ごとの値取得。
 */
function ggetResolveValueSimple_20260707_(task, config, oldMessage, name) {
  if (name === 'PJコード') {
    return ggetCleanCodeSimple_20260707_(
      ggetExtractCodeSimple_20260707_(oldMessage)
      || ggetValueSimple_20260707_(task, config, 'PJコード')
    );
  }

  if (name === '社内締切') {
    return ggetExtractDeadlineSimple_20260707_(oldMessage)
      || ggetValueSimple_20260707_(task, config, '社内締切');
  }

  if (name === '投稿日時') {
    return ggetLooseValueSimple_20260707_(task, config, [
      '投稿日時',
      '投稿日',
      '投稿時間'
    ]);
  }

  if (name === '社外シート') {
    return ggetLooseValueSimple_20260707_(task, config, [
      '社外シート',
      '社外sheet',
      '社外Sheet'
    ]);
  }

  if (name === '社内シート') {
    return ggetLooseValueSimple_20260707_(task, config, [
      '社内シート',
      '社内sheet',
      '社内Sheet'
    ]);
  }

  if (name === '備考') {
    return ggetLooseValueSimple_20260707_(task, config, [
      '備考',
      'メモ',
      'コメント'
    ]);
  }

  if (name === '展開メッセージ') {
    return '';
  }

  return ggetValueSimple_20260707_(task, config, name);
}


/**
 * header名から値取得。
 */
function ggetValueSimple_20260707_(task, config, headerName) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) {
    return '';
  }

  var index = config.currentHeaders.indexOf(headerName);

  if (index === -1) {
    return '';
  }

  var value = task.rawArray[index];

  if (value === null || value === undefined) {
    return '';
  }

  return value;
}


/**
 * 複数候補のheader名から値取得。
 */
function ggetLooseValueSimple_20260707_(task, config, headerNames) {
  for (var i = 0; i < headerNames.length; i++) {
    var value = ggetValueSimple_20260707_(task, config, headerNames[i]);

    if (ggetHasValueSimple_20260707_(value)) {
      return value;
    }
  }

  return '';
}


/**
 * 実質的に値があるか判定。
 */
function ggetHasValueSimple_20260707_(value) {
  if (value === null || value === undefined) {
    return false;
  }

  var text = String(value)
    .replace(/\r/g, '')
    .replace(/\n/g, '')
    .replace(/\t/g, '')
    .replace(/\s/g, '')
    .replace(/　/g, '')
    .trim();

  if (!text) {
    return false;
  }

  if (
    text === '⚠️未記入⚠️' ||
    text === '未記入' ||
    text === '-' ||
    text === 'ー'
  ) {
    return false;
  }

  return true;
}


/**
 * 旧message先頭のToだけ残す。
 */
function ggetExtractToPrefixSimple_20260707_(message) {
  var lines = String(message || '').split('\n');
  var toLines = [];

  for (var i = 0; i < lines.length; i++) {
    if (/^\[To:\d+\]/.test(lines[i])) {
      toLines.push(lines[i]);
    } else {
      break;
    }
  }

  if (toLines.length === 0) {
    return '';
  }

  return toLines.join('\n') + '\n\n';
}


/**
 * 旧messageから[code]内を取得。
 */
function ggetExtractCodeSimple_20260707_(message) {
  var match = String(message || '').match(/\[code\]([\s\S]*?)\[\/code\]/);
  return match ? match[1].trim() : '';
}


/**
 * PJコードにcodeタグが混ざった場合は除去。
 */
function ggetCleanCodeSimple_20260707_(value) {
  return String(value || '')
    .replace(/\[code\]/g, '')
    .replace(/\[\/code\]/g, '')
    .trim();
}


/**
 * 旧messageから〆以降を取得。
 */
function ggetExtractDeadlineSimple_20260707_(message) {
  var match = String(message || '').match(/〆([\s\S]*?)\[\/title\]/);
  return match ? match[1].trim() : '';
}


/**
 * replaceAll互換。
 */
function ggetReplaceAllSimple_20260707_(text, search, replacement) {
  return String(text).split(search).join(replacement);
}
