/**
 * GGET依頼管理表専用：
 * カテゴリーを見て通常依頼 / SNS依頼のテンプレートを自動で切り替える。
 *
 * 通常依頼：
 *   「依頼展開定型文」シート内の [ver.1] / 【ver.1】などから自動判定
 *
 * SNS依頼：
 *   「依頼展開定型文」シート内で SNS / 投稿日時 / SNS翻訳 / SNS投稿 を含むブロックを使用
 *
 * ※ [ver.1] / 【ver.1】などの行は展開文に含めない。
 * ※ テンプレート取得に失敗した場合は、旧messageを保持してToだけになる事故を防ぐ。
 */
function ggetModeRewriteV6_20260707_(parameters, botKun) {
  const config = botKun.pj.config.data;
  const templates = ggetReadTenkaiTemplatesV6_20260707_();

  console.log('========== GGET TEMPLATE AUTO MODE ==========');
  console.log('normal template preview = ' + String(templates.normal).slice(0, 200));
  console.log('sns template preview = ' + String(templates.sns).slice(0, 200));
  console.log('============================================');

  return ggetRewriteParamsV6_20260707_(parameters, config, templates);
}


/**
 * 「依頼展開定型文」シートからテンプレートを読む。
 *
 * A列全体を読み、
 * [ver.1] / 【ver.1】などの見出しでブロック分割する。
 *
 * SNSを含むブロック → SNSテンプレート
 * それ以外の最初のブロック → 通常テンプレート
 */
function ggetReadTenkaiTemplatesV6_20260707_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName('依頼展開定型文') ||
    ss.getSheetByName('テンプレート') ||
    ss.getSheetByName('設定');

  if (!sheet) {
    console.warn('template sheet not found');
    return {
      normal: '',
      sns: ''
    };
  }

  const lastRow = sheet.getLastRow();

  if (!lastRow || lastRow < 1) {
    console.warn('template sheet is empty');
    return {
      normal: '',
      sns: ''
    };
  }

  const values = sheet.getRange(1, 1, lastRow, 1).getDisplayValues();

  const lines = [];

  values.forEach(function(row) {
    const text = row[0];

    if (text === null || text === undefined || String(text).trim() === '') {
      return;
    }

    String(text).split('\n').forEach(function(line) {
      lines.push(line);
    });
  });

  const blocks = [];
  let current = [];

  lines.forEach(function(line) {
    const trimmed = String(line).trim();

    if (/^[【\[]ver\.\d+[】\]]$/i.test(trimmed)) {
      if (current.length > 0) {
        blocks.push(current.join('\n'));
      }

      current = [];
      return;
    }

    current.push(line);
  });

  if (current.length > 0) {
    blocks.push(current.join('\n'));
  }

  const cleanedBlocks = blocks
    .map(function(block) {
      return ggetCleanTemplateV6_20260707_(block);
    })
    .filter(function(block) {
      return String(block).trim() !== '';
    });

  let normalTemplate = '';
  let snsTemplate = '';

  cleanedBlocks.forEach(function(block) {
    if (/SNS|ＳＮＳ|投稿日時|SNS翻訳|SNS投稿/i.test(block)) {
      if (!snsTemplate) {
        snsTemplate = block;
      }
    } else {
      if (!normalTemplate) {
        normalTemplate = block;
      }
    }
  });

  console.log('template blocks count = ' + cleanedBlocks.length);
  console.log('normal template = ' + String(normalTemplate).slice(0, 200));
  console.log('sns template = ' + String(snsTemplate).slice(0, 200));

  return {
    normal: normalTemplate,
    sns: snsTemplate
  };
}


/**
 * [ver.1] / 【ver.1】などの行を削除する。
 */
function ggetCleanTemplateV6_20260707_(text) {
  if (!text) {
    return '';
  }

  let lines = String(text).split('\n');

  lines = lines.filter(function(line) {
    return !/^[【\[]ver\.\d+[】\]]$/i.test(String(line).trim());
  });

  return lines.join('\n').replace(/^\n+/, '').replace(/\n+$/, '');
}


/**
 * parameters 全体を再帰的に見て、依頼データ配列を処理する。
 *
 * 各依頼ごとにカテゴリーを確認し、
 * SNSならSNSテンプレート、それ以外なら通常テンプレートを使う。
 */
function ggetRewriteParamsV6_20260707_(value, config, templates) {
  if (Array.isArray(value)) {
    const hasTaskObjects = value.some(function(item) {
      return ggetIsTaskObjectV6_20260707_(item);
    });

    if (hasTaskObjects) {
      console.log('Task array found. count = ' + value.length);

      return value.map(function(item) {
        if (!ggetIsTaskObjectV6_20260707_(item)) {
          return item;
        }

        const requestNo = ggetGetValueByHeaderV6_20260707_(item, config, '依頼番号');
        const category = ggetGetValueByHeaderV6_20260707_(item, config, 'カテゴリー');
        const isSns = ggetIsSnsTaskV6_20260707_(item, config);

        console.log('task template check: ' + requestNo + ' / ' + category + ' / isSns=' + isSns);

        const template = isSns ? templates.sns : templates.normal;

        item.message = ggetMakeMessageFromTemplateV6_20260707_(item, config, template);

        if (item.message === null || item.message === undefined) {
          item.message = '';
        }

        return item;
      });
    }

    return value.map(function(item) {
      return ggetRewriteParamsV6_20260707_(item, config, templates);
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteParamsV6_20260707_(value[key], config, templates);
    });
  }

  return value;
}


/**
 * BotKun が生成した依頼データかどうか判定。
 */
function ggetIsTaskObjectV6_20260707_(obj) {
  return obj
    && typeof obj === 'object'
    && Array.isArray(obj.rawArray);
}


/**
 * カテゴリー列だけを見てSNS案件か判定。
 */
function ggetIsSnsTaskV6_20260707_(task, config) {
  const category = ggetGetValueByHeaderV6_20260707_(task, config, 'カテゴリー');
  return /SNS|ＳＮＳ/i.test(category || '');
}


/**
 * 指定テンプレートから message を作成。
 *
 * {PJコード}：
 *   BotKunが元々生成した [code]...[/code] を優先使用
 *
 * {社内締切}：
 *   BotKunが元々生成した title 内の「〆」以降を優先使用
 *
 * {展開メッセージ}：
 *   #REF! 混入防止のため空にする
 */
function ggetMakeMessageFromTemplateV6_20260707_(task, config, template) {
  const oldMessage = task.message || '';
  const toPrefix = ggetExtractToPrefixV6_20260707_(oldMessage);

  let message = template || '';

  if (!message) {
    console.warn('template is empty. keep old message.');
    return oldMessage;
  }

  const variablesToSearch = message.match(/(?<={)([^{}]+)(?=})/g) || [];

  variablesToSearch.forEach(function(headerName) {
    let value = '';

    if (headerName === 'PJコード') {
      value = ggetExtractCodeBlockV6_20260707_(oldMessage);

      if (!value) {
        value = ggetGetValueByHeaderV6_20260707_(task, config, headerName);
      }

    } else if (headerName === '社内締切') {
      value = ggetExtractDeadlineFromOldMessageV6_20260707_(oldMessage);

      if (!value) {
        value = ggetGetValueByHeaderV6_20260707_(task, config, headerName);
      }

    } else if (headerName === '展開メッセージ') {
      value = '';

    } else {
      value = ggetGetValueByHeaderV6_20260707_(task, config, headerName);
    }

    if (value === null || value === undefined) {
      value = '';
    }

    if (value instanceof Date) {
      value = ggetFormatDateV6_20260707_(value);
    }

    if (typeof value === 'string' && ggetIsDateStringV6_20260707_(value)) {
      value = ggetFormatDateV6_20260707_(new Date(value));
    }

    message = message.replaceAll('{' + headerName + '}', value);
  });

  return toPrefix + message;
}


/**
 * 既存messageの先頭にある [To:xxxx] 行だけを残す。
 */
function ggetExtractToPrefixV6_20260707_(message) {
  if (!message) {
    return '';
  }

  const lines = String(message).split('\n');
  const toLines = [];

  for (const line of lines) {
    if (/^\[To:\d+\]/.test(line)) {
      toLines.push(line);
    } else {
      break;
    }
  }

  if (toLines.length === 0) {
    return '';
  }

  return toLines.join('\n') + '\n';
}


/**
 * 旧messageから [code]...[/code] の中身を取得する。
 * PJコード復元用。
 */
function ggetExtractCodeBlockV6_20260707_(message) {
  if (!message) {
    return '';
  }

  const match = String(message).match(/\[code\]([\s\S]*?)\[\/code\]/);

  if (!match) {
    return '';
  }

  return match[1].trim();
}


/**
 * 旧messageから title 内の「〆」以降を取得する。
 * qtmeta付き日付を保持するため。
 */
function ggetExtractDeadlineFromOldMessageV6_20260707_(message) {
  if (!message) {
    return '';
  }

  const match = String(message).match(/〆([\s\S]*?)\[\/title\]/);

  if (!match) {
    return '';
  }

  return match[1].trim();
}


/**
 * header名から rawArray 内の値を取得。
 */
function ggetGetValueByHeaderV6_20260707_(task, config, headerName) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) {
    return '';
  }

  const colIndex = config.currentHeaders.indexOf(headerName);

  if (colIndex === -1) {
    console.warn('header not found: ' + headerName);
    console.log('currentHeaders = ' + JSON.stringify(config.currentHeaders));
    return '';
  }

  const value = task.rawArray[colIndex];

  if (value === null || value === undefined) {
    return '';
  }

  return value;
}


/**
 * Date型を m/d(曜) HH:mm に変換。
 */
function ggetFormatDateV6_20260707_(date) {
  let dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
  dateStr += `(${['日','月','火','水','木','金','土'][date.getDay()]}) `;

  let hours = date.getHours().toString();
  let minutes = date.getMinutes().toString();

  dateStr += hours.length === 1 ? '0' + hours : hours;
  dateStr += ':';
  dateStr += minutes.length === 1 ? '0' + minutes : minutes;

  return dateStr;
}


/**
 * Date文字列かどうか判定。
 */
function ggetIsDateStringV6_20260707_(value) {
  if (!value) {
    return false;
  }

  const date = new Date(value);

  return !isNaN(date.getTime())
    && /GMT|標準時|^\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(value);
}
