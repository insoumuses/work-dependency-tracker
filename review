// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  let botKun = BotKun.summon(magicIncantation);
  botKun.loadProject();

  // 通常通り3件取得
  let parameters = botKun.pj.tenkai.makeTenkaiParams(3);

  // GGET用：カテゴリーで通常 / SNS テンプレートを自動切替
  parameters = ggetModeRewriteV7_20260707_(parameters, botKun);

  console.log(JSON.stringify(parameters, null, 2));

  console.timeEnd('Loading message');
  return JSON.stringify(parameters);
}


/**
 * GGET依頼管理表専用：
 * カテゴリーを見て、通常依頼 / SNS依頼のテンプレートを自動切替する。
 *
 * 通常依頼：
 *   SNSを含まないカテゴリー
 *
 * SNS依頼：
 *   カテゴリーに SNS / ＳＮＳ が含まれるもの
 *
 * ※ 【ver.1】/【ver.2】は本文に入れない。
 * ※ {PJコード} は旧messageからBotKun生成済みの [code] 内を優先して取得する。
 */
function ggetModeRewriteV7_20260707_(parameters, botKun) {
  const config = botKun.pj.config.data;

  const templates = {
    normal:
`お疲れ様です(coffee)
下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}
{社内シート}
{備考}[/info]
[code]{PJコード}[/code]
よろしくお願いいたします。`,

    sns:
`お疲れ様です(coffee)
SNS関連の依頼が届きました。下記のご対応をお願いいたします。
[info][title]【{依頼番号}】〆{社内締切}[/title]
{カテゴリー}
{投稿日時}
{社外シート}
{備考}
[/info]
[code]{PJコード}[/code]
よろしくお願いいたします。`
  };

  console.log('========== GGET TEMPLATE AUTO MODE V7 ==========');
  console.log('normal template preview:\n' + templates.normal);
  console.log('sns template preview:\n' + templates.sns);
  console.log('================================================');

  return ggetRewriteParamsV7_20260707_(parameters, config, templates);
}


/**
 * parameters を再帰的に処理して message を書き換える。
 */
function ggetRewriteParamsV7_20260707_(value, config, templates) {
  if (Array.isArray(value)) {
    const hasTaskObjects = value.some(function(item) {
      return ggetIsTaskObjectV7_20260707_(item);
    });

    if (hasTaskObjects) {
      console.log('タスク配列を検出: ' + value.length + '件');

      return value.map(function(item) {
        if (!ggetIsTaskObjectV7_20260707_(item)) return item;

        const requestNo = ggetGetValueByHeaderV7_20260707_(item, config, '依頼番号');
        const category  = ggetGetValueByHeaderV7_20260707_(item, config, 'カテゴリー');
        const isSns     = ggetIsSnsTaskV7_20260707_(item, config);

        console.log('[' + requestNo + '] カテゴリー="' + category + '" / isSns=' + isSns);

        const template = isSns ? templates.sns : templates.normal;

        item.message = ggetMakeMessageFromTemplateV7_20260707_(item, config, template);

        if (item.message === null || item.message === undefined) {
          item.message = '';
        }

        return item;
      });
    }

    return value.map(function(item) {
      return ggetRewriteParamsV7_20260707_(item, config, templates);
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteParamsV7_20260707_(value[key], config, templates);
    });
  }

  return value;
}


/**
 * BotKun の依頼データオブジェクト判定。
 */
function ggetIsTaskObjectV7_20260707_(obj) {
  return obj && typeof obj === 'object' && Array.isArray(obj.rawArray);
}


/**
 * カテゴリー列で SNS 判定。
 */
function ggetIsSnsTaskV7_20260707_(task, config) {
  const category = ggetGetValueByHeaderV7_20260707_(task, config, 'カテゴリー');

  // SNS / ＳＮＳ / sns すべて対応
  return /SNS|ＳＮＳ/i.test(String(category || ''));
}


/**
 * テンプレートから message を生成。
 */
function ggetMakeMessageFromTemplateV7_20260707_(task, config, template) {
  const oldMessage = task.message || '';
  const toPrefix   = ggetExtractToPrefixV7_20260707_(oldMessage);

  let message = String(template || '');

  const variablesToSearch = message.match(/(?<={)([^{}]+)(?=})/g) || [];

  variablesToSearch.forEach(function(headerName) {
    let value = ggetResolveTemplateValueV7_20260707_(task, config, oldMessage, headerName);

    if (value === null || value === undefined) value = '';

    if (value instanceof Date) {
      value = ggetFormatDateV7_20260707_(value);
    } else if (typeof value === 'string' && ggetIsDateStringV7_20260707_(value)) {
      value = ggetFormatDateV7_20260707_(new Date(value));
    }

    message = ggetReplaceAllV7_20260707_(message, '{' + headerName + '}', String(value));
  });

  // 念のため、ver見出しが混入した場合は削除
  message = message
    .replace(/^[\s　]*[【\[]ver\.\d+[】\]][\s　]*\n?/gmi, '')
    .replace(/\[code\]\s*\[\/code\]/g, '[code][/code]');

  return toPrefix + message;
}


/**
 * テンプレート変数ごとの値を取得。
 */
function ggetResolveTemplateValueV7_20260707_(task, config, oldMessage, headerName) {
  if (headerName === 'PJコード') {
    return ggetCleanCodeValueV7_20260707_(
      ggetExtractCodeBlockV7_20260707_(oldMessage)
      || ggetGetValueByHeaderV7_20260707_(task, config, 'PJコード')
    );
  }

  if (headerName === '社内締切') {
    return ggetExtractDeadlineFromOldMessageV7_20260707_(oldMessage)
      || ggetGetValueByHeaderV7_20260707_(task, config, '社内締切');
  }

  if (headerName === '社内シート') {
    return ggetGetValueByHeaderLooseV7_20260707_(task, config, [
      '社内シート',
      '社内sheet',
      '社内Sheet',
      '社内SHEET'
    ]);
  }

  if (headerName === '社外シート') {
    return ggetGetValueByHeaderLooseV7_20260707_(task, config, [
      '社外シート',
      '社外sheet',
      '社外Sheet',
      '社外SHEET'
    ]);
  }

  if (headerName === '投稿日時') {
    return ggetGetValueByHeaderLooseV7_20260707_(task, config, [
      '投稿日時',
      '投稿日',
      '投稿日'
    ]);
  }

  if (headerName === '展開メッセージ') {
    return '';
  }

  return ggetGetValueByHeaderV7_20260707_(task, config, headerName);
}


/**
 * ヘッダー名の揺れに対応して値を取得。
 */
function ggetGetValueByHeaderLooseV7_20260707_(task, config, headerNames) {
  for (const name of headerNames) {
    const value = ggetGetValueByHeaderV7_20260707_(task, config, name, true);
    if (value !== '') {
      return value;
    }
  }

  console.warn('対象ヘッダーが見つかりません: ' + JSON.stringify(headerNames));
  return '';
}


/**
 * headerName から rawArray の値を取得。
 */
function ggetGetValueByHeaderV7_20260707_(task, config, headerName, silent) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) return '';

  const colIndex = config.currentHeaders.indexOf(headerName);

  if (colIndex === -1) {
    if (!silent) {
      console.warn('ヘッダーが見つかりません: "' + headerName + '"');
      console.log('currentHeaders = ' + JSON.stringify(config.currentHeaders));
    }
    return '';
  }

  const value = task.rawArray[colIndex];
  return (value === null || value === undefined) ? '' : value;
}


/**
 * 旧messageの先頭 [To:xxxx] 行だけ取り出す。
 */
function ggetExtractToPrefixV7_20260707_(message) {
  if (!message) return '';

  const lines = String(message).split('\n');
  const toLines = [];

  for (const line of lines) {
    if (/^\[To:\d+\]/.test(line)) {
      toLines.push(line);
    } else {
      break;
    }
  }

  return toLines.length > 0 ? toLines.join('\n') + '\n\n' : '';
}


/**
 * 旧messageから [code]...[/code] を取得。
 */
function ggetExtractCodeBlockV7_20260707_(message) {
  if (!message) return '';

  const match = String(message).match(/\[code\]([\s\S]*?)\[\/code\]/);
  return match ? match[1].trim() : '';
}


/**
 * PJコード値に [code] / [/code] が混ざっていた場合に除去。
 */
function ggetCleanCodeValueV7_20260707_(value) {
  return String(value || '')
    .replace(/\[code\]/g, '')
    .replace(/\[\/code\]/g, '')
    .trim();
}


/**
 * 旧messageから title 内の「〆」以降を取得。
 */
function ggetExtractDeadlineFromOldMessageV7_20260707_(message) {
  if (!message) return '';

  const match = String(message).match(/〆([\s\S]*?)\[\/title\]/);
  return match ? match[1].trim() : '';
}


/**
 * Date → m/d(曜) HH:mm
 */
function ggetFormatDateV7_20260707_(date) {
  const days = ['日','月','火','水','木','金','土'];
  const m   = date.getMonth() + 1;
  const d   = date.getDate();
  const w   = days[date.getDay()];
  const h   = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');

  return `${m}/${d}(${w}) ${h}:${min}`;
}


/**
 * Date文字列かどうか判定。
 */
function ggetIsDateStringV7_20260707_(value) {
  if (!value) return false;

  const str = String(value);
  const date = new Date(str);

  return !isNaN(date.getTime())
    && /GMT|標準時|^\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(str);
}


/**
 * Apps Script用 replaceAll 互換。
 */
function ggetReplaceAllV7_20260707_(text, search, replacement) {
  return String(text).split(search).join(replacement);
}
