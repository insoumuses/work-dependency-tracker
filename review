// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  let botKun = BotKun.summon(magicIncantation);
  botKun.loadProject();

  // GGET用：
  // 3種類の定型文を使って展開するため、まずは3件取得
  let parameters = botKun.pj.tenkai.makeTenkaiParams(3);

  parameters = ggetModeRewriteV5_20260707_(parameters, botKun);

  console.log(JSON.stringify(parameters, null, 2));

  console.timeEnd('Loading message');
  return JSON.stringify(parameters);
}


/**
 * GGET依頼管理表専用：
 * 担当者が設定!A2へテンプレートをコピーしなくても、
 * 「依頼展開定型文」シート上の3種類のテンプレートを使って展開する。
 *
 * A2:A10  → 1件目
 * A11:A17 → 2件目
 * A20:A24 → 3件目
 *
 * ※ 【ver.1】などの行は展開メッセージには含めない。
 */
function ggetModeRewriteV5_20260707_(parameters, botKun) {
  const config = botKun.pj.config.data;
  const templates = ggetReadTenkaiTemplatesV5_20260707_();

  console.log('========== GGET TEMPLATE CHECK ==========');
  console.log(JSON.stringify(templates, null, 2));
  console.log('=========================================');

  return ggetRewriteParamsV5_20260707_(parameters, config, templates);
}


/**
 * 「依頼展開定型文」シートから3種類のテンプレートを読む。
 * 【ver.1】/【ver.2】/【ver.3】 の行は削除する。
 */
function ggetReadTenkaiTemplatesV5_20260707_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // シート名が違う場合に備えて、候補を順番に見る
  const sheet =
    ss.getSheetByName('依頼展開定型文') ||
    ss.getSheetByName('設定');

  if (!sheet) {
    console.warn('依頼展開定型文 sheet not found');
    return ['', '', ''];
  }

  const ranges = [
    'A2:A10',
    'A11:A17',
    'A20:A24'
  ];

  return ranges.map(function(rangeA1) {
    const values = sheet.getRange(rangeA1).getDisplayValues()
      .map(function(row) {
        return row[0];
      })
      .join('\n');

    return ggetCleanTemplateV5_20260707_(values);
  });
}


/**
 * テンプレート先頭の【ver.1】などを削除し、
 * 余計な空行を軽く整える。
 */
function ggetCleanTemplateV5_20260707_(text) {
  if (!text) {
    return '';
  }

  let lines = String(text).split('\n');

  // 空行を保ちつつ、ver行だけ削除
  lines = lines.filter(function(line) {
    return !/^【ver\.\d+】\s*$/.test(String(line).trim());
  });

  return lines.join('\n').replace(/^\n+/, '').replace(/\n+$/, '');
}


/**
 * parameters 全体を再帰的に見て、依頼データ配列を処理する。
 *
 * 依頼データが見つかったら、先頭から最大3件に対して
 * 1件目 → template[0]
 * 2件目 → template[1]
 * 3件目 → template[2]
 * を適用する。
 */
function ggetRewriteParamsV5_20260707_(value, config, templates) {
  if (Array.isArray(value)) {
    const hasTaskObjects = value.some(function(item) {
      return ggetIsTaskObjectV5_20260707_(item);
    });

    if (hasTaskObjects) {
      console.log('Task array found. before count = ' + value.length);

      const result = [];
      let taskCount = 0;

      value.forEach(function(item) {
        // task object 以外はUI側で必要な可能性があるので残す
        if (!ggetIsTaskObjectV5_20260707_(item)) {
          result.push(item);
          return;
        }

        // 表示する依頼は最大3件まで
        if (taskCount >= 3) {
          const requestNo = ggetGetValueByHeaderV5_20260707_(item, config, '依頼番号');
          console.log('filtered by count limit: ' + requestNo);
          return;
        }

        const template = templates[taskCount] || templates[0] || '';
        item.message = ggetMakeMessageFromTemplateV5_20260707_(item, config, template);

        if (item.message === null || item.message === undefined) {
          item.message = '';
        }

        result.push(item);
        taskCount++;
      });

      console.log('Task array after count = ' + result.length);
      console.log('Task count after filter = ' + taskCount);

      return result;
    }

    return value.map(function(item) {
      return ggetRewriteParamsV5_20260707_(item, config, templates);
    });
  }

  if (value && typeof value === 'object') {
    Object.keys(value).forEach(function(key) {
      value[key] = ggetRewriteParamsV5_20260707_(value[key], config, templates);
    });
  }

  return value;
}


/**
 * BotKun が生成した依頼データかどうか判定。
 * message が未生成の場合もあるため、rawArray があれば依頼データとして扱う。
 */
function ggetIsTaskObjectV5_20260707_(obj) {
  return obj
    && typeof obj === 'object'
    && Array.isArray(obj.rawArray);
}


/**
 * 指定テンプレートから message を作成。
 *
 * 注意：
 * {PJコード} と {社内締切} は、BotKun が元々生成した message から優先して復元する。
 * これにより、PJコードの自動取得や qtmeta 付きの日付形式を壊さない。
 */
function ggetMakeMessageFromTemplateV5_20260707_(task, config, template) {
  const oldMessage = task.message || '';
  const toPrefix = ggetExtractToPrefixV5_20260707_(oldMessage);

  let message = template || '';

  const variablesToSearch = message.match(/(?<={)([^{}]+)(?=})/g) || [];

  variablesToSearch.forEach(function(headerName) {
    let value = '';

    if (headerName === 'PJコード') {
      // PJコードは表の列ではなくBotKun側で自動生成されている可能性があるため、
      // 旧messageの[code]...[/code]から優先取得する。
      value = ggetExtractCodeBlockV5_20260707_(oldMessage);

      if (!value) {
        value = ggetGetValueByHeaderV5_20260707_(task, config, headerName);
      }

    } else if (headerName === '社内締切') {
      // 社内締切はqtmeta付き形式を保持したいため、
      // 旧messageの title 内にある「〆」以降を優先取得する。
      value = ggetExtractDeadlineFromOldMessageV5_20260707_(oldMessage);

      if (!value) {
        value = ggetGetValueByHeaderV5_20260707_(task, config, headerName);
      }

    } else if (headerName === '展開メッセージ') {
      // 旧S列の展開メッセージは使わない。
      // ここを読むと、表格函数の結果が混ざって重複する可能性があるため。
      value = '';

    } else {
      value = ggetGetValueByHeaderV5_20260707_(task, config, headerName);
    }

    if (value === null || value === undefined) {
      value = '';
    }

    if (value instanceof Date) {
      value = ggetFormatDateV5_20260707_(value);
    }

    if (typeof value === 'string' && ggetIsDateStringV5_20260707_(value)) {
      value = ggetFormatDateV5_20260707_(new Date(value));
    }

    message = message.replaceAll('{' + headerName + '}', value);
  });

  return toPrefix + message;
}


/**
 * 既存messageの先頭にある [To:xxxx] 行だけを残す
 */
function ggetExtractToPrefixV5_20260707_(message) {
  if (!message) {
    return '';
  }

  const lines = message.split('\n');
  const toLines = [];

  for (const line of lines) {
    if (/^\[To:\d+\]/.test(line)) {
      toLines.push(line);
    } else {
      break;
    }
  }

  if (toLines.length === 0) {
    return '';
  }

  return toLines.join('\n') + '\n';
}


/**
 * 旧messageから [code]...[/code] の中身を取得する。
 * {PJコード} 復元用。
 */
function ggetExtractCodeBlockV5_20260707_(message) {
  if (!message) {
    return '';
  }

  const match = String(message).match(/\[code\]([\s\S]*?)\[\/code\]/);

  if (!match) {
    return '';
  }

  return match[1].trim();
}


/**
 * 旧messageから title 内の「〆」以降を取得する。
 * qtmeta付き日付を保持するため。
 *
 * 例：
 * [info][title]【GG_260702_1】〆[qt][qtmeta aid=...][/qt][/title]
 */
function ggetExtractDeadlineFromOldMessageV5_20260707_(message) {
  if (!message) {
    return '';
  }

  const match = String(message).match(/〆([\s\S]*?)\[\/title\]/);

  if (!match) {
    return '';
  }

  return match[1].trim();
}


/**
 * header名から rawArray 内の値を取得
 */
function ggetGetValueByHeaderV5_20260707_(task, config, headerName) {
  if (!task || !task.rawArray || !config || !config.currentHeaders) {
    return '';
  }

  const colIndex = config.currentHeaders.indexOf(headerName);

  if (colIndex === -1) {
    console.warn('header not found: ' + headerName);
    console.log('currentHeaders = ' + JSON.stringify(config.currentHeaders));
    return '';
  }

  const value = task.rawArray[colIndex];

  if (value === null || value === undefined) {
    return '';
  }

  return value;
}


/**
 * Date型を m/d(曜) HH:mm に変換
 */
function ggetFormatDateV5_20260707_(date) {
  let dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
  dateStr += `(${['日','月','火','水','木','金','土'][date.getDay()]}) `;

  let hours = date.getHours().toString();
  let minutes = date.getMinutes().toString();

  dateStr += hours.length === 1 ? '0' + hours : hours;
  dateStr += ':';
  dateStr += minutes.length === 1 ? '0' + minutes : minutes;

  return dateStr;
}


/**
 * Date文字列かどうか判定
 */
function ggetIsDateStringV5_20260707_(value) {
  if (!value) {
    return false;
  }

  const date = new Date(value);

  return !isNaN(date.getTime())
    && /GMT|標準時|^\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(value);
}
